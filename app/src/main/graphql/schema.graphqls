"""
A person associated with a package (sender or receiver). May be registered or unregistered.
"""
type PackagePerson {
  """
  Internal UUID
  """
  id: ID!

  """
  Role — SENDER or RECEIVER
  """
  role: PersonRole!

  """
  User ID if this person is a registered user
  """
  userId: ID

  """
  Display name
  """
  name: String

  """
  Phone number
  """
  phone: String
}

"""
Current lifecycle status of a package.
"""
enum PackageStatus {
  """
  Package has been created and is waiting to be accepted
  """
  CREATED

  """
  Package has been accepted by a worker
  """
  ACCEPTED

  """
  Package has been picked up by the driver
  """
  PICKED_UP

  """
  Package is in transit to its destination
  """
  IN_TRANSIT

  """
  Delivery has been initiated — a delivery code was generated and published to the sender/receiver; awaiting confirmDelivery
  """
  PENDING_CONFIRMATION

  """
  Package has been delivered to the receiver
  """
  DELIVERED

  """
  Package delivery is fully completed
  """
  COMPLETED

  """
  Package has been cancelled
  """
  CANCELLED

  """
  Package has arrived at the origin office (FIXED_ROUTE only)
  """
  ORIGIN_OFFICE

  """
  A driver has been assigned to the package (FIXED_ROUTE only)
  """
  ASSIGNED_DRIVER

  """
  Package has arrived at the destination office (FIXED_ROUTE only)
  """
  DESTINATION_OFFICE

  """
  Package is ready for the receiver to collect (FIXED_ROUTE only)
  """
  READY_FOR_COLLECTION
}

"""
Input: a person associated with the package (sender or receiver).
"""
input PersonInput {
  """
  Role — SENDER or RECEIVER
  """
  role: PersonRole!

  """
  User ID if this person is a registered user
  """
  userId: ID

  """
  Display name
  """
  name: String

  """
  Phone number
  """
  phone: String
}

"""
Role of a person associated with a package (sender or receiver).
"""
enum PersonRole {
  """
  The person sending the package
  """
  SENDER

  """
  The person receiving the package
  """
  RECEIVER
}

"""
Read operations.
"""
type Query {
  """
  List all registered users.
  """
  users: [User!]!

  """
  Search users by name, role, and/or company. All filters are optional and combinable.
  """
  searchUsers("Text to match against first name, last name or user name (optional)." query: String, "Filter by system role (optional)." role: Role, "Filter by company/office ID (optional)." companyId: ID): [User!]!

  """
  Get a single user by internal UUID.
  """
  user(id: ID!): User

  """
  Get the profile of the currently authenticated user. Requires authentication.
  """
  myProfile: User

  """
  Get a package by internal UUID.
  """
  package(id: ID!): DeliveryPackage

  """
  Get a package by its public tracking code.
  """
  packageByTrackingCode(code: String!): DeliveryPackage

  """
  Get all packages created by a specific user.
  """
  packagesByCreator(creatorId: ID!, "Optional filter by status." status: PackageStatus, "Sort order by creation date (ASC, DESC). Defaults to ASC." order: SortOrder = ASC, "Page number (0-based). Defaults to 0." page: Int = 0, "Page size. Defaults to 20." size: Int = 20): DeliveryPackagePage!

  """
  Get all packages currently assigned to a specific driver.
  """
  packagesByDriver(driverId: ID!, "Optional filter by status." status: PackageStatus, "Sort order by creation date (ASC, DESC). Defaults to ASC." order: SortOrder = ASC, "Page number (0-based). Defaults to 0." page: Int = 0, "Page size. Defaults to 20." size: Int = 20): DeliveryPackagePage!

  """
  Get all packages by current lifecycle status.
  """
  packagesByStatus(status: PackageStatus!, "Sort order by creation date (ASC, DESC). Defaults to ASC." order: SortOrder = ASC, "Page number (0-based). Defaults to 0." page: Int = 0, "Page size. Defaults to 20." size: Int = 20): DeliveryPackagePage!

  """
  Get all packages where a user is a custodian in a specific role.
  """
  packagesByCustodian(role: CustodianRole!, custodianId: ID!, "Optional filter by status." status: PackageStatus, "Sort order by creation date (ASC, DESC). Defaults to ASC." order: SortOrder = ASC, "Page number (0-based). Defaults to 0." page: Int = 0, "Page size. Defaults to 20." size: Int = 20): DeliveryPackagePage!

  """
  Get all packages where a user is a custodian in any role.
  """
  packagesByUser(userId: ID!, "Optional filter by status." status: PackageStatus, "Sort order by creation date (ASC, DESC). Defaults to ASC." order: SortOrder = ASC, "Page number (0-based). Defaults to 0." page: Int = 0, "Page size. Defaults to 20." size: Int = 20): DeliveryPackagePage!

  """
  Get packages for the authenticated user. CUSTOMER: packages where user is sender/receiver (by userId or phone). WORKER: packages with status CREATED or where user is a custodian. DRIVER: packages where user is a custodian.
  """
  myPackages("Optional filter by status." status: PackageStatus, "Sort order by creation date (ASC, DESC). Defaults to ASC." order: SortOrder = ASC, "Page number (0-based). Defaults to 0." page: Int = 0, "Page size. Defaults to 20." size: Int = 20): DeliveryPackagePage!

  """
  Get all packages that are available to be accepted (status = CREATED).
  """
  availablePackages("Optional filter by status." status: PackageStatus, "Sort order by creation date (ASC, DESC). Defaults to ASC." order: SortOrder = ASC, "Page number (0-based). Defaults to 0." page: Int = 0, "Page size. Defaults to 20." size: Int = 20): DeliveryPackagePage!

  """
  Get the event timeline for a package.
  """
  packageHistory(packageId: ID!): [PackageEvent!]!

  """
  Get the custody-transfer history for a package.
  """
  packageCustody(packageId: ID!): [PackageCustody!]!

  """
  Get a transfer by internal UUID. Requires authentication.
  """
  transfer(id: ID!): Transfer!

  """
  Get all transfers created by the authenticated user. Requires authentication.
  """
  myTransfers: [Transfer!]!

  """
  Get transfers by status. Requires authentication.
  """
  transfersByStatus(status: TransferStatus!): [Transfer!]!

  """
  Get the authenticated user's notice feed, newest first. Requires authentication.
  """
  myNotices: [Notice!]!

  """
  Count of unread notices for the authenticated user. Requires authentication.
  """
  unreadNoticeCount: Int!
}

"""
Input: regenerate a secure transfer code.
"""
input RegenerateTransferCodeInput {
  """
  Transfer UUID
  """
  transferId: ID!
}

"""
System-level roles assigned to users. Determines access and permissions across the platform.
"""
enum Role {
  """
  Super admin — full system access
  """
  SUPER_ADMIN

  """
  Admin — elevated management access
  """
  ADMIN

  """
  Customer — end user who creates delivery requests
  """
  CUSTOMER

  """
  Worker — operational employee who handles packages
  """
  WORKER

  """
  Driver — responsible for transporting packages
  """
  DRIVER
}

"""
Sort direction.
"""
enum SortOrder {
  """
  Ascending order (oldest first).
  """
  ASC

  """
  Descending order (newest first).
  """
  DESC
}

"""
Built-in String
"""
scalar String

"""
Real-time subscriptions. Requires WebSocket transport.
"""
type Subscription {
  """
  Real-time notification for newly created packages that include an auto-created transfer.
  Events are filtered per-subscriber based on the transfer's targeting fields:
  - acceptorType: DRIVER → only Driver role; WORKER → only Worker role; BOTH → all
  - matchUserId: if set, only events targeting that specific user
  - matchCompanyId: if set, only users belonging to that company
  Only authenticated users with DRIVER or WORKER roles receive events.
  """
  newPackageTransfer: PackageCreation!
}

"""
A transfer groups multiple packages for coordinated handover.
"""
type Transfer {
  """
  Internal UUID
  """
  id: ID!

  """
  User who created the transfer
  """
  creatorId: ID!

  """
  Rule type — AUTO or SECURE
  """
  ruleType: TransferRuleType!

  """
  Who can accept this transfer (default BOTH)
  """
  acceptorType: TransferAcceptorType!

  """
  Optional company filter
  """
  matchCompanyId: ID

  """
  Optional user filter
  """
  matchUserId: ID

  """
  User who requested this transfer (CONFIRM mode)
  """
  requestorId: ID

  """
  Current status
  """
  status: TransferStatus!

  """
  Transfer code for SECURE transfers (only returned on create/regenerate — null in queries)
  """
  transferCode: String

  """
  Packages in this transfer
  """
  packages: [TransferPackage!]!

  """
  ISO-8601 timestamp of creation
  """
  createdAt: String!

  """
  ISO-8601 timestamp of last update
  """
  updatedAt: String!
}

"""
Return type for acceptPackageByTransfer mutation. Contains the completed transfer and the list of accepted packages.
"""
type TransferAcceptResult {
  """
  The completed transfer
  """
  transfer: Transfer!

  """
  List of accept results for each package in the transfer
  """
  acceptedPackages: [AcceptOffer!]!
}

"""
Who can accept/join a transfer.
"""
enum TransferAcceptorType {
  """
  Only workers can accept
  """
  WORKER

  """
  Only drivers can accept
  """
  DRIVER

  """
  Both workers and drivers can accept (default)
  """
  BOTH
}

"""
A package linked to a transfer.
"""
type TransferPackage {
  """
  Internal UUID
  """
  id: ID!

  """
  Transfer this package belongs to
  """
  transferId: ID!

  """
  The package UUID
  """
  packageId: ID!

  """
  User who added the package
  """
  addedBy: ID!

  """
  ISO-8601 timestamp when added
  """
  addedAt: String!
}

"""
Rule type for a package transfer.
"""
enum TransferRuleType {
  """
  Automatic transfer — no code required
  """
  AUTO

  """
  Secure transfer — requires a transfer code for verification
  """
  SECURE

  """
  Confirm transfer — user requests, owner confirms acceptance
  """
  CONFIRM
}

"""
Current status of a package transfer.
"""
enum TransferStatus {
  """
  Transfer is pending (open and active)
  """
  PENDING

  """
  User has requested this CONFIRM transfer — waiting for owner confirmation
  """
  REQUESTED

  """
  Transfer has been completed
  """
  DONE

  """
  Transfer has been cancelled
  """
  CANCELED
}

"""
Input: advance a package to a new status.
"""
input UpdatePackageStatusInput {
  """
  Package UUID
  """
  packageId: ID!

  """
  User performing the update
  """
  actorId: ID!

  """
  Target status — must be a valid transition from the current status
  """
  status: PackageStatus!

  """
  Handover token for custody transfer (required for PICKED_UP transition)
  """
  handoverToken: String

  """
  Six-digit pickup code (required for COMPLETED transition)
  """
  pickupCode: String

  """
  Optional notes about the status change
  """
  notes: String
}

"""
Input: initiate delivery for a package. Transitions to PENDING_CONFIRMATION and generates a one-time delivery code.
"""
input InitiateDeliveryInput {
  """
  Package UUID
  """
  packageId: ID!
}

"""
Input: confirm delivery of a package that is PENDING_CONFIRMATION. Requires the delivery code. Sets the package to DELIVERED.
"""
input ConfirmDeliveryInput {
  """
  Package UUID
  """
  packageId: ID!

  """
  Six-digit delivery code received via the notice feed
  """
  deliveryCode: String!
}

"""
Input: regenerate the delivery code for a package. Only allowed while the package is PENDING_CONFIRMATION.
"""
input RegenerateDeliveryCodeInput {
  """
  Package UUID
  """
  packageId: ID!
}

"""
Input: update a transfer's rule type or acceptor type.
"""
input UpdateTransferInput {
  """
  Transfer UUID
  """
  transferId: ID!

  """
  New rule type (nullable — omit to keep current)
  """
  ruleType: TransferRuleType

  """
  New acceptor type (nullable — omit to keep current)
  """
  acceptorType: TransferAcceptorType
}

"""
Registered user of the platform. Users are synced from Supabase Auth.
"""
type User {
  """
  Internal UUID
  """
  id: ID!

  """
  Email address (from Supabase)
  """
  email: String!

  """
  Phone number
  """
  phone: String

  """
  Given name
  """
  firstName: String

  """
  Family name
  """
  lastName: String

  """
  User name
  """
  username: String

  """
  System role — determines permissions
  """
  role: Role!

  """
  Account status
  """
  status: UserStatus!

  """
  ISO-8601 timestamp of creation
  """
  createdAt: String!

  """
  ISO-8601 timestamp of last update
  """
  updatedAt: String!
}

"""
Account status for a user.
"""
enum UserStatus {
  """
  User is active and can use the platform
  """
  ACTIVE

  """
  User has been disabled (e.g. banned from Supabase)
  """
  DISABLED

  """
  User has not yet been fully activated
  """
  PENDING
}

type __Directive {
  """
  The __Directive type represents a Directive that a server supports.
  """
  name: String!

  description: String

  isRepeatable: Boolean!

  locations: [__DirectiveLocation!]!

  args(includeDeprecated: Boolean = false): [__InputValue!]!
}

"""
An enum describing valid locations where a directive can be placed
"""
enum __DirectiveLocation {
  """
  Indicates the directive is valid on queries.
  """
  QUERY

  """
  Indicates the directive is valid on mutations.
  """
  MUTATION

  """
  Indicates the directive is valid on subscriptions.
  """
  SUBSCRIPTION

  """
  Indicates the directive is valid on fields.
  """
  FIELD

  """
  Indicates the directive is valid on fragment definitions.
  """
  FRAGMENT_DEFINITION

  """
  Indicates the directive is valid on fragment spreads.
  """
  FRAGMENT_SPREAD

  """
  Indicates the directive is valid on inline fragments.
  """
  INLINE_FRAGMENT

  """
  Indicates the directive is valid on variable definitions.
  """
  VARIABLE_DEFINITION

  """
  Indicates the directive is valid on a schema SDL definition.
  """
  SCHEMA

  """
  Indicates the directive is valid on a scalar SDL definition.
  """
  SCALAR

  """
  Indicates the directive is valid on an object SDL definition.
  """
  OBJECT

  """
  Indicates the directive is valid on a field SDL definition.
  """
  FIELD_DEFINITION

  """
  Indicates the directive is valid on a field argument SDL definition.
  """
  ARGUMENT_DEFINITION

  """
  Indicates the directive is valid on an interface SDL definition.
  """
  INTERFACE

  """
  Indicates the directive is valid on an union SDL definition.
  """
  UNION

  """
  Indicates the directive is valid on an enum SDL definition.
  """
  ENUM

  """
  Indicates the directive is valid on an enum value SDL definition.
  """
  ENUM_VALUE

  """
  Indicates the directive is valid on an input object SDL definition.
  """
  INPUT_OBJECT

  """
  Indicates the directive is valid on an input object field SDL definition.
  """
  INPUT_FIELD_DEFINITION
}

type __EnumValue {
  name: String!

  description: String

  isDeprecated: Boolean!

  deprecationReason: String
}

type __Field {
  name: String!

  description: String

  args(includeDeprecated: Boolean = false): [__InputValue!]!

  type: __Type!

  isDeprecated: Boolean!

  deprecationReason: String
}

type __InputValue {
  name: String!

  description: String

  type: __Type!

  defaultValue: String

  isDeprecated: Boolean

  deprecationReason: String
}

"""
A GraphQL Introspection defines the capabilities of a GraphQL server. It exposes all available types and directives on the server, the entry points for query, mutation, and subscription operations.
"""
type __Schema {
  description: String

  """
  A list of all types supported by this server.
  """
  types: [__Type!]!

  """
  The type that query operations will be rooted at.
  """
  queryType: __Type!

  """
  If this server supports mutation, the type that mutation operations will be rooted at.
  """
  mutationType: __Type

  """
  A list of all directives supported by this server.
  """
  directives: [__Directive!]!

  """
  If this server support subscription, the type that subscription operations will be rooted at.
  """
  subscriptionType: __Type
}

type __Type {
  kind: __TypeKind!

  name: String

  description: String

  fields(includeDeprecated: Boolean = false): [__Field!]

  interfaces: [__Type!]

  possibleTypes: [__Type!]

  enumValues(includeDeprecated: Boolean = false): [__EnumValue!]

  inputFields(includeDeprecated: Boolean = false): [__InputValue!]

  ofType: __Type

  """
  This field is considered experimental because it has not yet been ratified in the graphql specification
  """
  isOneOf: Boolean

  specifiedByURL: String

  specifiedByUrl: String @deprecated(reason: "This legacy name has been replaced by `specifiedByURL`")
}

"""
An enum describing what kind of type a given __Type is
"""
enum __TypeKind {
  """
  Indicates this type is a scalar. `specifiedByURL` is a valid field
  """
  SCALAR

  """
  Indicates this type is an object. `fields` and `interfaces` are valid fields.
  """
  OBJECT

  """
  Indicates this type is an interface. `fields` and `possibleTypes` are valid fields.
  """
  INTERFACE

  """
  Indicates this type is a union. `possibleTypes` is a valid field.
  """
  UNION

  """
  Indicates this type is an enum. `enumValues` is a valid field.
  """
  ENUM

  """
  Indicates this type is an input object. `inputFields` is a valid field.
  """
  INPUT_OBJECT

  """
  Indicates this type is a list. `ofType` is a valid field.
  """
  LIST

  """
  Indicates this type is a non-null. `ofType` is a valid field.
  """
  NON_NULL
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true
"""
directive @include("Included when true." if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip("Skipped when true." if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
Marks the field, argument, input field or enum value as deprecated
"""
directive @deprecated("The reason for the deprecation" reason: String! = "No longer supported") on FIELD_DEFINITION | ARGUMENT_DEFINITION | ENUM_VALUE | INPUT_FIELD_DEFINITION

"""
Exposes a URL that specifies the behaviour of this scalar.
"""
directive @specifiedBy("The URL that specifies the behaviour of this scalar." url: String!) on SCALAR

"""
Indicates an Input Object is a OneOf Input Object.
"""
directive @oneOf on INPUT_OBJECT

"""
This directive allows results to be deferred during execution
"""
directive @defer("Deferred behaviour is controlled by this argument" if: Boolean! = true, "A unique label that represents the fragment being deferred" label: String) on FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
This directive disables error propagation when a non nullable field returns null for the given operation.
"""
directive @experimental_disableErrorPropagation on QUERY | MUTATION | SUBSCRIPTION

schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

