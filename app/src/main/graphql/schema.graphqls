  """
  createdAt: String!
}

"""
A geographic location associated with a package (origin or destination).
"""
type PackageLocation {
  """
  Internal UUID
  """
  id: ID!

  """
  Whether this is ORIGIN or DESTINATION
  """
  type: LocationType!

  """
  Latitude
  """
  latitude: Float!

  """
  Longitude
  """
  longitude: Float!

  """
  Human-readable place name
  """
  placeName: String

  """
  External place ID (e.g. Google Maps place ID)
  """
  placeId: String

  """
  Optional office UUID if this location is an office
  """
