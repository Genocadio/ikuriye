"""
Return type for acceptPackage mutation. Contains the updated package and the generated pickup code.
"""
type AcceptOffer {
  """
  The updated delivery package
  """
  deliveryPackage: DeliveryPackage!

  """
  Six-digit numeric pickup code — required when completing the package. One-time use. Null if a code already existed (e.g. driver-created package).
  """
  pickupCode: String
}

"""
Return type for initiateDelivery / regenerateDeliveryCode mutations. Contains the updated package and the one-time delivery code.
"""
type DeliveryCodeResult {
  """
  The updated delivery package
  """
  deliveryPackage: DeliveryPackage!

  """
  Six-digit numeric delivery code — required by confirmDelivery to confirm the delivery. One-time display only.
  """
  deliveryCode: String!
}

"""
Input: accept packages via a transfer (transition from CREATED to ACCEPTED for all packages in the transfer).
"""
input AcceptTransferInput {
  """
  Transfer UUID
  """
  transferId: ID!

  """
  Transfer code — required for SECURE transfers, optional for AUTO
  """
  transferCode: String
}

"""
Input: add packages to an existing transfer.
"""
input AddPackagesToTransferInput {
  """
  Transfer UUID
  """
  transferId: ID!

  """
  Package UUIDs to add
  """
  packageIds: [ID!]!
}

"""
Input: assign a driver to a package.
"""
input AssignDriverInput {
  """
  Package UUID
  """
  packageId: ID!

  """
  Driver to assign
  """
  driverId: ID!

  """
  User who is making the assignment
  """
  assignedBy: ID!

  """
  Handover token from the previous custodian. Required for custody transfer.
  """
  handoverToken: String!

  """
  Optional notes about the assignment
  """
  notes: String
}

"""
Input: assign a company/office to a package.
"""
input AssignPackageCompanyInput {
  """
  Package UUID
  """
  packageId: ID!

  """
  Company/office UUID
  """
  companyId: ID!
}

"""
Input: assign a trip identifier to a package.
"""
input AssignPackageTripInput {
  """
  Package UUID
  """
  packageId: ID!

  """
  Trip UUID
  """
  tripId: ID!
}

"""
Input: assign a new system role to a user.
"""
input AssignRoleInput {
  """
  User UUID
  """
  userId: ID!

  """
  Target role
  """
  role: Role!
}

"""
Built-in Boolean
"""
scalar Boolean

input CreatePackageInput {
  """
  Type of delivery (OPEN or FIXED_ROUTE)
  """
  deliveryType: DeliveryType!

  """
  Sender information (optional for authenticated CUSTOMER users — auto-filled from profile)
  """
  sender: PersonInput

  """
  Receiver information
  """
  receiver: PersonInput!

  """
  Pickup location
  """
  origin: LocationInput!

  """
  Drop-off location
  """
  destination: LocationInput!

  """
  Optional item details
  """
  details: DetailInput

  """
  Optional: auto-create a transfer with this package
  """
  transferRuleType: TransferRuleType

  """
  Optional: match company filter for auto-created transfer
  """
  transferMatchCompanyId: ID

  """
  Optional: match user filter for auto-created transfer
  """
  transferMatchUserId: ID
}

"""
Input: create a new transfer.
"""
input CreateTransferInput {
  """
  Package UUIDs to include in the transfer
  """
  packageIds: [ID!]!

  """
  Rule type — AUTO or SECURE
  """
  ruleType: TransferRuleType!

  """
  Who can accept this transfer (default BOTH)
  """
  acceptorType: TransferAcceptorType = BOTH

  """
  Optional company to match
  """
  matchCompanyId: ID

  """
  Optional user to match
  """
  matchUserId: ID
}

"""
Role a user plays as custodian of a package at a given stage.
"""
enum CustodianRole {
  """
  A worker currently handling the package
  """
  WORKER

  """
  The driver transporting the package
  """
  DRIVER

  """
  An office that holds the package (origin or destination)
  """
  OFFICE

  """
  The receiver who the package is delivered to
  """
  RECEIVER
}

"""
A delivery package — the core domain entity.
"""
type DeliveryPackage {
  """
  Internal UUID
  """
  id: ID!

  """
  Public-facing tracking code (e.g. CAV-XXXXXXXX)
  """
  trackingCode: String!

  """
  Type of delivery (OPEN or FIXED_ROUTE)
  """
  deliveryType: DeliveryType!

  """
  Current lifecycle status
  """
  status: PackageStatus!

  """
  User who created the package
  """
  creatorId: ID!

  """
  Company / office associated with the package
  """
  companyId: ID

  """
  Trip identifier for grouped shipments
  """
  tripId: ID

  """
  History of custodians who held this package
  """
  custodians: [PackageCustodian!]!

  """
  Sender and receiver information
  """
  people: [PackagePerson!]!

  """
  Origin and destination locations
  """
  locations: [PackageLocation!]!

  """
  Optional package details (category, weight, dimensions, etc.)
  """
  details: PackageDetails

  """
  Timeline of events
  """
  events: [PackageEvent!]!

  """
  History of custody transfers
  """
  custody: [PackageCustody!]!

  """
  Open transfers containing this package (PENDING or REQUESTED). Frontend can use transfer.ruleType to determine if a code is required.
  """
  transfers: [Transfer!]!

  """
  ISO-8601 timestamp of creation
  """
  createdAt: String!

  """
  ISO-8601 timestamp of last update
  """
  updatedAt: String!
}

"""
Paginated delivery package results.
"""
type DeliveryPackagePage {
  """
  List of packages for the current page.
  """
  items: [DeliveryPackage!]!

  """
  Total number of packages matching the query.
  """
  totalCount: Int!

  """
  Total number of pages.
  """
  totalPages: Int!

  """
  Current page number (0-based).
  """
  currentPage: Int!
}

"""
Delivery type for a package.
"""
enum DeliveryType {
  """
  Open delivery — flexible status transitions (CREATED → ACCEPTED → PICKED_UP → IN_TRANSIT → DELIVERED → COMPLETED)
  """
  OPEN

  """
  Fixed-route delivery — follows office-to-office flow (CREATED → ORIGIN_OFFICE → ASSIGNED_DRIVER → IN_TRANSIT → DESTINATION_OFFICE → READY_FOR_COLLECTION → COMPLETED)
  """
  FIXED_ROUTE
}

"""
Input: optional package details.
"""
input DetailInput {
  """
  Category / type of item
  """
  category: String

  """
  Free-text description
  """
  description: String

  """
  Whether the item is fragile
  """
  fragile: Boolean

  """
  Weight in kg
  """
  weight: Float

  """
  Length in cm
  """
  length: Float

  """
  Width in cm
  """
  width: Float

  """
  Height in cm
  """
  height: Float

  """
  Declared monetary value
  """
  declaredValue: Float

  """
  Media links (videos or pictures)
  """
  media: [MediaInput!]
}

"""
Built-in Float
"""
scalar Float

"""
Input: generate a pickup code for a package.
"""
input GeneratePickupCodeInput {
  """
  Package UUID
  """
  packageId: ID!
}

"""
Built-in ID
"""
scalar ID

"""
Built-in Int
"""
scalar Int

"""
Input: a geographic location for the shipment.
"""
input LocationInput {
  """
  Whether this is ORIGIN or DESTINATION
  """
  type: LocationType!

  """
  Latitude
  """
  latitude: Float!

  """
  Longitude
  """
  longitude: Float!

  """
  Human-readable place name
  """
  placeName: String

  """
  External place ID
  """
  placeId: String

  """
  Optional office UUID
  """
  officeId: ID
}

"""
Whether a location is the origin or destination of a shipment.
"""
enum LocationType {
  """
  Pickup / sender location
  """
  ORIGIN

  """
  Drop-off / receiver location
  """
  DESTINATION
}

"""
Input: a media link associated with a package.
"""
input MediaInput {
  """
  URL of the media
  """
  url: String!

  """
  Type of media
  """
  mediaType: MediaType!
}

"""
Type of media link.
"""
enum MediaType {
  """
  Video link
  """
  VIDEO

  """
  Picture link
  """
  PICTURE
}

"""
Write operations.
"""
type Mutation {
  """
  Sync the authenticated user's profile from Supabase Auth into the local database. Creates a new user if none exists, updates fields if they changed, and toggles DISABLED status if the Supabase user is banned.
  """
  syncUser: User!

  """
  Assign a new system role to a user. Super Admin only.
  """
  assignRole(input: AssignRoleInput!): User!

  """
  Disable a user account. Admin or Super Admin only.
  """
  disableUser(userId: ID!): User!

  """
  Create a new delivery package. WORKER and DRIVER creators become the first custodian. CUSTOMER creators are not custodians. Returns a one-time handover token. If transferRuleType is provided, automatically creates a transfer with this package.
  """
  createPackage(input: CreatePackageInput!): PackageCreation!

  """
  Accept a transfer — behaviour depends on the transfer's ruleType: AUTO auto-accepts and auto-completes, SECURE requires transferCode then auto-accepts and auto-completes, CONFIRM sets to REQUESTED for owner approval.
  """
  acceptTransfer(input: AcceptTransferInput!): TransferAcceptResult!

  """
  Assign a driver to a package. Transitions FIXED_ROUTE packages to ASSIGNED_DRIVER status. Worker, Driver (self-assign or transfer), Admin, or Super Admin only.
  """
  assignDriver(input: AssignDriverInput!): DeliveryPackage!

  """
  Advance a package to the next status. Validates state-machine transitions, pickup codes (for COMPLETED), and handover tokens (for custody transfers).
  """
  updatePackageStatus(input: UpdatePackageStatusInput!): DeliveryPackage!

  """
  Initiate delivery: transitions the package to PENDING_CONFIRMATION, generates a one-time delivery code, and publishes the status change + code to the sender and receiver only via their notice feed (custodians never receive the code). Current custodian (Worker/Driver) only.
  """
  initiateDelivery(input: InitiateDeliveryInput!): DeliveryCodeResult!

  """
  Confirm delivery: verifies the delivery code and sets the package to DELIVERED. Callable by the sender, receiver, or the custodian who initiated delivery.
  """
  confirmDelivery(input: ConfirmDeliveryInput!): DeliveryPackage!

  """
  Regenerate the delivery code while the package is PENDING_CONFIRMATION. Invalidates the previous code and re-publishes the new one to the notice feed. Current custodian only.
  """
  regenerateDeliveryCode(input: RegenerateDeliveryCodeInput!): DeliveryCodeResult!

  """
  Assign a company/office to a package.
  """
  assignPackageCompany(input: AssignPackageCompanyInput!): DeliveryPackage!

  """
  Assign a trip identifier to a package.
  """
  assignPackageTrip(input: AssignPackageTripInput!): DeliveryPackage!

  """
  Generate a six-digit numeric pickup code for a package. Returns the updated package and the raw pickup code (one-time display). Fails if an unused code already exists.
  """
  generatePickupCode(input: GeneratePickupCodeInput!): AcceptOffer!

  """
  Create a new transfer with one or more packages. If ruleType is SECURE, a transfer code is generated and returned. Requires authentication.
  """
  createTransfer(input: CreateTransferInput!): Transfer!

  """
  Add packages to an existing transfer. Only the transfer owner can add packages. If a package is in another open transfer owned by the same user, it is moved. Requires authentication.
  """
  addPackagesToTransfer(input: AddPackagesToTransferInput!): Transfer!

  """
  Regenerate the transfer code for a SECURE transfer. Only the transfer owner can regenerate. Requires authentication.
  """
  regenerateTransferCode(input: RegenerateTransferCodeInput!): Transfer!

  """
  Update a transfer (change rule type). Only the transfer owner can update. Requires authentication.
  """
  updateTransfer(input: UpdateTransferInput!): Transfer!

  """
  Cancel a transfer. Only the transfer owner can cancel.
  """
  cancelTransfer(transferId: ID!): Transfer!

  """
  Confirm a REQUESTED CONFIRM transfer. Only the transfer owner can confirm. Auto-accepts packages for the requestor and completes the transfer.
  """
  confirmTransfer(transferId: ID!): Transfer!

  """
  Reject a REQUESTED CONFIRM transfer. Only the transfer owner can reject. Resets status back to PENDING and clears requestor.
  """
  rejectTransfer(transferId: ID!): Transfer!
}

"""
A notice — one event that multiple recipients can view.
"""
type Notice {
  """
  Internal UUID
  """
  id: ID!

  """
  PACKAGE or TRANSFER
  """
  resourceType: String!

  """
  The package or transfer this notice is about
  """
  resourceId: ID!

  """
  Type of event (e.g. PACKAGE_DELIVERED, TRANSFER_DONE)
  """
  eventType: String!

  """
  User who caused the event, if applicable
  """
  actorId: ID

  """
  Short human-readable title
  """
  title: String!

  """
  Human-readable message with resource-specific details
  """
  message: String!

  """
  JSON payload with before/after state, tracking code, etc.
  """
  payload: String

  """
  Delivery status for the current user
  """
  viewer: NoticeViewer!

  """
  ISO-8601 timestamp of creation
  """
  createdAt: String!
}

"""
Per-user delivery/read state for a notice.
"""
type NoticeViewer {
  """
  Internal UUID
  """
  id: ID!

  """
  The notice this viewer row belongs to
  """
  noticeId: ID!

  """
  The recipient user
  """
  userId: ID!

  """
  ISO-8601 timestamp when the notice was delivered to this user
  """
  deliveredAt: String

  """
  ISO-8601 timestamp when the user read the notice, null if unread
  """
  readAt: String
}

"""
Return type for createPackage mutation. Contains the created package, one-time handover token, and optional transfer.
"""
type PackageCreation {
  """
  The created delivery package
  """
  deliveryPackage: DeliveryPackage!

  """
  One-time handover token — required for subsequent custody transfers. Store securely, only returned once.
  """
  handoverToken: String!

  """
  Optional transfer auto-created with the package. Present when transferRuleType was provided in CreatePackageInput.
  """
  transfer: Transfer
}

type PackageCustodian {
  """
  Internal UUID
  """
  id: ID!

  """
  User who holds custody
  """
  userId: ID!

  """
  Display name of the custodian
  """
  name: String

  """
  Phone number of the custodian
  """
  phone: String

  """
  Role at time of custody
  """
  role: CustodianRole!

  """
  ISO-8601 timestamp when custody was assigned
  """
  assignedAt: String!
}

"""
A record of custody being transferred from one entity to another.
"""
type PackageCustody {
  """
  Internal UUID
  """
  id: ID!

  """
  Who custody was transferred from
  """
  fromEntity: String!

  """
  Who custody was transferred to
  """
  toEntity: String!

  """
  ISO-8601 timestamp of the transfer
  """
  timestamp: String!

  """
  Optional notes about the transfer
  """
  notes: String
}

"""
Optional metadata about a package (category, weight, dimensions, declared value).
"""
type PackageDetails {
  """
  Category / type of item
  """
  category: String

  """
  Free-text description
  """
  description: String

  """
  Whether the item is fragile
  """
  fragile: Boolean!

  """
  Weight (kg)
  """
  weight: Float

  """
  Length (cm)
  """
  length: Float

  """
  Width (cm)
  """
  width: Float

  """
  Height (cm)
  """
  height: Float

  """
  Declared monetary value
  """
  declaredValue: Float

  """
  Media links (videos or pictures)
  """
  media: [PackageMedia!]
}

type PackageEvent {
  """
  Internal UUID
  """
  id: ID!

  """
  Type of event (e.g. CREATED, ACCEPTED, PICKED_UP)
  """
  eventType: String!

  """
  User who performed the action
