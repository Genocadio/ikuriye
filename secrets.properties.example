# ─────────────────────────────────────────────────────────────────────────────
#  secrets.properties — REQUIRED app configuration
#
#  How to use:
#    1. Copy this file to `secrets.properties` (same folder, project root):
#         cp secrets.properties.example secrets.properties
#    2. Fill in your real values below.
#    3. NEVER commit `secrets.properties` — it is git-ignored.
#
#  These values are baked into BuildConfig at build time (no runtime fetch), so
#  you must rebuild after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Used for auth, storage (media), and realtime (notifications).
SUPABASE_URL=

# Supabase anon / publishable key ("anon" key from Dashboard → Settings → API).
# It is safe to embed in a client app; Row Level Security protects the data.
SUPABASE_KEY=

# GraphQL delivery-backend endpoint (Apollo client + codegen introspection).
# If you change this, also keep the schema at app/src/main/graphql/schema.graphqls in sync.
GRAPHQL_URL=https://api.med.rw/deliveries/graphql

# Supabase Storage bucket for package media uploads (must exist in your project).
MEDIA_BUCKET=package-media

# Supabase Storage bucket for profile pictures (must exist in your project).
PROFILE_BUCKET=profiles

# ─────────────────────────────────────────────────────────────────────────────
#  CI / GitHub Actions
#
#  The release workflow (.github/workflows/release.yml) reads the SAME keys from
#  GitHub Secrets as env vars — no secrets.properties file is committed. Set
#  these in Settings → Secrets and variables → Actions:
#
#    SUPABASE_URL, SUPABASE_KEY, GRAPHQL_URL   (required)
#    MEDIA_BUCKET, PROFILE_BUCKET              (optional, defaults above)
#
#  Release signing (required for production releases):
#
#    KEYSTORE_BASE64      base64 of release.jks →  base64 -w0 release.jks
#    KEYSTORE_PASSWORD    keystore password
#    KEY_ALIAS            key alias
#    KEY_PASSWORD         key password
#
#  Generate the keystore once locally:
#    keytool -genkey -v -keystore release.jks -alias <alias> -keyalg RSA \
#      -keysize 2048 -validity 10000
#
#  VERSION_NAME / VERSION_CODE are computed automatically from the git tag
#  (tag v1.2.3 → versionName 1.2.3) and commit count — no need to set them.
# ─────────────────────────────────────────────────────────────────────────────
